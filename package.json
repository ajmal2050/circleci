{
  "name": "circleci-demo-app",
  "version": "1.0.0",
  "main": "backend/server.js",
  "scripts": {
   
    "start": "node backend/server.js",

    
    "test": "node --test test/*.test.js",

    "test:backend:unit": "node --test --test-reporter=junit --test-reporter-destination=test-results/backend-unit/results.xml test/backend-unit.test.js",

 
    "test:backend:integration": "node --test --test-reporter=junit --test-reporter-destination=test-results/backend-integration/results.xml test/backend-integration.test.js",

  
    "test:frontend:dom": "node --test --test-reporter=junit --test-reporter-destination=test-results/frontend-dom/results.xml test/frontend-dom.test.js",

    
    "test:frontend:state": "node --test --test-reporter=junit --test-reporter-destination=test-results/frontend-state/results.xml test/frontend-state.test.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jsdom": "^24.0.0"
  }
}